<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <!-- 差し替え先アニメーションのピッカー（行は C# で動的生成） -->
    <ui:VisualElement class="dennoko-card-header dennoko-card-header--row dennoko-fx-picker-head">
        <ui:Label name="picker-title" class="dennoko-section-title dennoko-card-header__title" />
        <ui:Button name="picker-folder-button" text="…" class="dennoko-icon-button" />
    </ui:VisualElement>
    <ui:Label name="picker-folder-label" class="dennoko-hint dennoko-fx-picker-folder" />
    <ui:TextField name="picker-search" class="dennoko-fx-picker-search" />
    <ui:Label name="picker-empty" class="dennoko-empty-state__message dennoko-fx-picker-empty" style="display: none;" />
    <ui:ScrollView name="picker-list" class="dennoko-scroll" />
</ui:UXML>
