/* ============================================================
   DenEmoStyles.uss
   DenEmo 固有の UI クラス定義。
   汎用テーマは DennokoTheme.uss に置き、ここにはプロジェクト固有の
   レイアウト・バリアントのみを追加する（テーマ差し替えを容易にするため）。
   カラーは DennokoTheme.uss の USS 変数を経由すること。
   ============================================================ */

/* 追加変数（テーマ変数から派生した DenEmo 固有色） */
.dennoko-root {
    --dennoko-fav-active: #ffd91a;
    --dennoko-rec-text: var(--dennoko-semantic-error-text);
}

/* ─── ウィンドウ骨格 ─────────────────────────────────────────
   上から: トップバー → タブ → (録画中バナー) → モードのページ → 出力ドック → フッター → ステータス。
   固定クロームの flex-shrink: 0 はテーマ / ブロック側で設定済み。
   ScrollView の中のカードはコンテンツが長いときに潰れないよう縮ませない
   (リストカードは DennokoBlocks.uss の .dennoko-card.dennoko-list-card が詳細度で上書きして伸び縮みする)。 */

.dennoko-root .dennoko-card {
    flex-shrink: 0;
}

.dennoko-root #anim-scroll #unity-content-container > *,
.dennoko-root #pose-scroll #unity-content-container > *,
.dennoko-root #fx-scroll #unity-content-container > * {
    flex-shrink: 0;
}

/* flex-basis: 0 がないと ScrollView がコンテンツ実寸を希望サイズとして報告し、
   コンテンツが長いときに兄弟のフッター・ステータスバーが押しつぶされる (上部スクロールは下で auto に戻す)。 */
.dennoko-root .dennoko-scroll {
    flex-basis: 0;
}

/* Pose / Animation / FX のページ: 上部 (対象・設定・タイムライン) + リストカード (残りの高さ)。
   P3 なのでページ全体はスクロールさせない */
.dennoko-root .dennoko-page {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

/* 上部: 中身の高さで並び、窓が低いときだけ先に縮んでスクロールする。リストに場所を残すため最大 60% */
.dennoko-root .dennoko-scroll.dennoko-upper-scroll {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    max-height: 60%;
}

/* リストカードの置き場所 (ShapeKeyList.uxml の TemplateContainer を C# がここへ移動する) */
.dennoko-root .dennoko-list-slot {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 180px;
}

/* ─── 録画中バナー (B7 の作業中バナーを録画に使う) ─────────── */

/* 録画中の点だけは録画の慣習に合わせて赤にする (背景・左端の線はテーマの selection のまま) */
.dennoko-root .dennoko-session-dot.dennoko-session-dot--rec {
    background-color: var(--dennoko-rec-text);
}

.dennoko-root .dennoko-session-banner__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 6px;
    font-size: 10px;
    color: var(--dennoko-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dennoko-root .dennoko-session-banner > .unity-button.dennoko-button-secondary {
    flex-shrink: 0;
    min-height: 0;
    height: 22px;
    margin: 0;
    padding: 0 10px;
}

/* ─── 汎用レイアウト ─────────────────────────────────────── */

.dennoko-root .dennoko-col-fixed {
    width: 90px;
    flex-shrink: 0;
}

/* トグルで開く従属項目 (枠で囲まずインデントだけで従属を示す) */
.dennoko-root .dennoko-indent {
    margin-left: 16px;
}

/* カード下部の操作ボタン行。通常 / Secondary ボタンを均等に並べ、狭いときは折り返す
   (主ボタンはフッターの 1 つだけなのでここには置かない) */
.dennoko-root .dennoko-card-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.dennoko-root .dennoko-card-actions > .unity-button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 140px;
    margin: 2px;
}

/* カード見出し行の右端の小さな文字ボタン */
.dennoko-root .dennoko-card-header--row > .unity-button.dennoko-card-header__action {
    flex-shrink: 0;
    min-height: 0;
    height: 20px;
    margin: 0 0 0 4px;
    padding: 0 8px;
    font-size: 10px;
}

/* 伸びる入力欄の右に置く固定幅ボタン (参照…) */
.dennoko-root .unity-button.dennoko-row-action {
    width: 56px;
    flex-shrink: 0;
    margin-right: 0;
}

/* ─── B1 対象カード (DenEmo 固有の追加メッシュ行) ─────────── */

.dennoko-root .dennoko-target-row > .unity-button.dennoko-icon-button {
    margin-left: 2px;
}

.dennoko-root .dennoko-target-row.dennoko-target-row--sub {
    margin-top: 2px;
}

.dennoko-root .dennoko-target-row__prefix {
    width: 14px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    color: var(--dennoko-text-tertiary);
}

/* ─── アニメーションクリップ / 補正 / 別窓通知 ───────────────── */

.dennoko-root .dennoko-guide {
    margin-top: 6px;
}

.dennoko-root .dennoko-guide > .dennoko-hint {
    margin-bottom: 2px;
}

/* 補正カードは詳細 (.dennoko-details) をカード全体の見出しとして使う */
.dennoko-root .dennoko-details.dennoko-details--card {
    margin-top: 0;
}

.dennoko-root .dennoko-details--card > .dennoko-details__content {
    margin-left: 0;
    margin-top: 6px;
}

.dennoko-root .dennoko-correction-columns {
    margin-top: 6px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--dennoko-outline-subtle);
}

/* 上部スクロールの中の入れ子スクロールなので高さに上限を付ける */
.dennoko-root .dennoko-correction-rows {
    max-height: 240px;
    margin-top: 2px;
}

.dennoko-root .dennoko-correction-rows #unity-content-container > * {
    flex-shrink: 0;
}

.dennoko-root .dennoko-correction-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
}

.dennoko-root .dennoko-correction-row .unity-float-field {
    width: 90px;
    flex-shrink: 0;
    margin: 0 1px;
}

/* ─── リストカードの絞り込み行 ───────────────────────────── */

/* 絞り込みチップ行（横並び・折り返し）。チップの見た目と選択中の青はブロック USS に任せる */
.dennoko-root .dennoko-filter-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 2px;
}

.dennoko-root .dennoko-filter-row > .unity-button.dennoko-chip,
.dennoko-root .dennoko-filter-row > .unity-button.dennoko-icon-button {
    margin: 0 4px 4px 0;
}

/* 複数メッシュの絞り込み */
.dennoko-root .dennoko-mesh-filter {
    min-width: 110px;
    max-width: 45%;
    flex-shrink: 1;
    margin: 0 0 4px 4px;
}

/* フッター情報欄の警告 (キーフレームなし等) */
.dennoko-root .dennoko-footer__info.dennoko-footer__info--warning {
    color: var(--dennoko-semantic-warning);
}

/* Animation のフッター: 情報欄 (トラック数・キー数) と主ボタンを 1:2 で分け、情報が見切れないようにする */
.dennoko-root .dennoko-footer.dennoko-footer--split > .dennoko-footer__info {
    flex-grow: 1;
    flex-basis: 0;
    max-width: none;
}

.dennoko-root .dennoko-footer.dennoko-footer--split > .unity-button.dennoko-button-primary {
    flex-grow: 2;
    flex-basis: 0;
}

/* フッター左端の「上書き保存」(Pose / Animation)。保存ボタンの近くに置くためフッター内に置く */
.dennoko-root .dennoko-footer > .unity-toggle.dennoko-footer__toggle {
    flex-shrink: 0;
    margin: 0 4px 0 2px;
}

/* 出力ドックの保存設定 (Pose): 上書き先の ObjectField は行の残りを使い、オプションは文字幅で並べる */
.dennoko-root .dennoko-output-row > .unity-object-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.dennoko-root .dennoko-output-row > .unity-toggle {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 12px 0 0;
}

/* ─── Timeline(Exp): UI Toolkit 版タイムライン（検証） ─────── */

.dennoko-root .dennoko-tl-settings,
.dennoko-root .dennoko-tl-transport {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

.dennoko-root .dennoko-tl-settings {
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--dennoko-outline-subtle);
}

.dennoko-root .dennoko-tl-group {
    flex-direction: row;
    align-items: center;
    margin: 2px 4px;
}

.dennoko-root .dennoko-tl-caption {
    -unity-text-align: middle-left;
    margin: 0 2px;
    flex-shrink: 0;
}

.dennoko-root .dennoko-tl-num {
    width: 46px;
    margin: 0 2px;
    flex-shrink: 0;
}

.dennoko-root .dennoko-tl-num .unity-base-field__input {
    min-height: 18px;
    padding: 1px 3px;
}

.dennoko-root .unity-button.dennoko-tl-transport-btn {
    width: 24px;
    height: 20px;
    font-size: 10px;
    color: var(--dennoko-text-secondary);
}

.dennoko-root .unity-button.dennoko-tl-play {
    width: 34px;
}

/* 補間 segmented / 全キー適用 / ループ / クリップ欄（タイムライン内の最小オーバーライド） */
.dennoko-root .dennoko-tl-interp {
    margin: 0 4px 0 2px;
    flex-shrink: 0;
}

.dennoko-root .dennoko-tl-interp > .unity-button {
    flex-basis: auto;
    min-height: 16px;
    padding: 1px 8px;
    font-size: 10px;
}

.dennoko-root .unity-button.dennoko-tl-apply-all {
    min-height: 0;
    height: 20px;
    margin: 0;
    padding: 0 8px;
    font-size: 10px;
}

.dennoko-root .dennoko-tl-loop-toggle {
    margin: 0 8px 0 4px;
}

.dennoko-root .dennoko-tl-clip-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 1px 2px;
}

.dennoko-root .dennoko-tl-lane-notice {
    padding: 12px 0 0 12px;
}

.dennoko-root .dennoko-tl-area {
    margin-top: 8px;
    padding: 2px;
}

/* 左固定パネル + 右レーンの 1 行 */
.dennoko-root .dennoko-tl-strip {
    flex-direction: row;
    align-items: stretch;
}

.dennoko-root .dennoko-tl-left {
    flex-shrink: 0;
    position: relative;
    flex-direction: row;
    align-items: center;
}

.dennoko-root .dennoko-tl-splitter {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: var(--dennoko-outline-subtle);
}

.dennoko-root .dennoko-tl-lane {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
    position: relative;
    overflow: hidden;
}

.dennoko-root .dennoko-tl-ruler {
    background-color: var(--dennoko-surface-2);
}

.dennoko-root .dennoko-tl-scrub,
.dennoko-root .dennoko-tl-scrollbar,
.dennoko-root .dennoko-tl-track-lane {
    background-color: var(--dennoko-surface-0);
}

.dennoko-root .dennoko-tl-tracks {
    margin-top: 0;
}

.dennoko-root .dennoko-tl-tracks > .unity-scroll-view__content-and-vertical-scroll-container,
.dennoko-root .dennoko-tl-tracks #unity-content-viewport,
.dennoko-root .dennoko-tl-tracks #unity-content-container {
    flex-grow: 1;
}

.dennoko-root .dennoko-tl-tracks #unity-content-container > * {
    flex-shrink: 0;
}

.dennoko-root .dennoko-tl-tracks #unity-content-container > .dennoko-tl-tracks-filler {
    flex-shrink: 1;
    flex-grow: 1;
}

.dennoko-root .dennoko-tl-tracks-filler {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    min-height: 0;
}

.dennoko-root .dennoko-tl-filler-lane {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-right: 16px;
    background-color: var(--dennoko-surface-0);
}

/* ルーラーの目盛りラベル（レーン基準の絶対配置） */
.dennoko-root .dennoko-tl-tick {
    position: absolute;
    font-size: 9px;
    color: var(--dennoko-text-tertiary);
}

.dennoko-root .dennoko-tl-tick-tiny {
    position: absolute;
    font-size: 8px;
    color: var(--dennoko-text-tertiary);
}

/* トラック行の左パネル内訳 */
.dennoko-root .dennoko-tl-track-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    font-size: 11px;
    color: var(--dennoko-text-tertiary);
    margin-left: 8px;
}

.dennoko-root .unity-button.dennoko-tl-key-btn {
    width: 25px;
    flex-shrink: 0;
    color: var(--dennoko-text-secondary);
}

/* ズームコントロール（ルーラー左パネル） */
.dennoko-root .dennoko-tl-zoombox {
    flex-direction: column;
    justify-content: center;
    padding-left: 4px;
    flex-grow: 1;
}

.dennoko-root .dennoko-tl-zoom-pct {
    font-size: 9px;
    color: var(--dennoko-text-tertiary);
}

.dennoko-root .unity-button.dennoko-tl-zoom-reset {
    width: auto;
    min-width: 0;
    align-self: flex-start;
    height: 14px;
    font-size: 9px;
    padding: 0 4px;
    margin: 2px 0 0 0;
}

/* フレーム移動ハンドル行（トラック下部）: ↔ ドラッグでフレーム内の全キーを移動 */
.dennoko-root .dennoko-tl-action-lane {
    background-color: var(--dennoko-surface-0);
    border-top-width: 1px;
    border-top-color: var(--dennoko-outline-subtle);
}

/* ↔ ハンドル（レーン基準の絶対配置） */
.dennoko-root .dennoko-tl-action-handle {
    position: absolute;
    top: 0;
    width: 20px;
    height: 14px;
    font-size: 10px;
    -unity-text-align: middle-center;
    color: var(--dennoko-text-tertiary);
    cursor: slide-arrow;
}

/* ─── FX モード（アバターへ適用） ────────────────────────── */

/* 一覧を出さないとき (FX コントローラー未指定) は上部だけになるので 60% の上限を外す */
.dennoko-root .dennoko-scroll.dennoko-upper-scroll.dennoko-upper-scroll--full {
    max-height: none;
}

/* 補足文の警告版 (直接変更の説明・FX レイヤーへの手動セット) */
.dennoko-root .dennoko-hint.dennoko-hint--warning {
    color: var(--dennoko-semantic-warning);
}

/* 最後の適用結果 (アバター / FX カードの最後) */
.dennoko-root .dennoko-fx-result {
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--dennoko-outline-subtle);
}

.dennoko-root .dennoko-fx-result__row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.dennoko-root .dennoko-fx-result__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dennoko-root .dennoko-fx-result__path {
    color: var(--dennoko-text-tertiary);
}

/* ジェスチャー絞り込み: 手のチップとジェスチャーのチップの間の区切り */
.dennoko-root .dennoko-fx-filter-sep {
    width: 1px;
    height: 14px;
    flex-shrink: 0;
    margin: 0 6px 4px 2px;
    background-color: var(--dennoko-outline-subtle);
}

/* 1 エントリ (行 + パス不一致の注記 + 展開した参照箇所)。エントリの間は細い罫線 */
.dennoko-root .dennoko-fx-entry {
    border-bottom-width: 1px;
    border-bottom-color: var(--dennoko-outline-subtle);
}

/* 行は B4 の .dennoko-list-row を ScrollView で使う。ListView 用の height: 100% は外す */
.dennoko-root .dennoko-list-row.dennoko-fx-row {
    height: auto;
    min-height: 24px;
    padding: 1px 4px 1px 4px;
}

.dennoko-root .dennoko-list-row.dennoko-fx-row:hover {
    background-color: var(--dennoko-hover-overlay);
}

/* シーンでプレビュー再生中の行 */
.dennoko-root .dennoko-list-row.dennoko-fx-row.dennoko-fx-row--playing {
    background-color: var(--dennoko-selection-bg);
}

/* 割当て済みは左端に success のアクセントバー (線の幅だけ左の余白を減らして位置を揃える) */
.dennoko-root .dennoko-list-row.dennoko-fx-row.dennoko-fx-row--assigned {
    padding-left: 2px;
    border-left-width: 2px;
    border-left-color: var(--dennoko-semantic-success);
}

/* 展開トグル (複数参照のときだけ) と、無いときの位置合わせ (アイコンボタン 20px + 余白 2px) */
.dennoko-root .unity-button.dennoko-icon-button.dennoko-fx-fold {
    margin: 0 2px 0 0;
    font-size: 9px;
}

.dennoko-root .dennoko-fx-spacer {
    width: 22px;
    flex-shrink: 0;
}

/* クリップ名 (クリックで Project の該当クリップを Ping) */
.dennoko-root .dennoko-list-row__name.dennoko-fx-name {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 11px;
    cursor: link;
}

.dennoko-root .dennoko-list-row__name.dennoko-fx-name:hover {
    color: var(--dennoko-semantic-info);
}

.dennoko-root .dennoko-list-row__name.dennoko-fx-name.dennoko-fx-name--mismatch {
    color: var(--dennoko-semantic-warning);
}

/* ジェスチャータグ (クリップ名の右隣) */
.dennoko-root .dennoko-fx-gesture-tag {
    height: 16px;
    flex-shrink: 0;
    margin-left: 4px;
    padding: 0 5px;
    font-size: 9px;
    -unity-text-align: middle-center;
    color: var(--dennoko-text-secondary);
    background-color: var(--dennoko-surface-2);
    border-width: 1px;
    border-color: var(--dennoko-outline-subtle);
    border-radius: 8px;
}

/* 差し替え先スロット (クリックでピッカー、D&D 受付) */
.dennoko-root .unity-button.dennoko-fx-slot {
    width: 40%;
    min-width: 90px;
    max-width: 180px;
    flex-shrink: 1;
    min-height: 0;
    height: 20px;
    margin: 0;
    padding: 0 6px;
    font-size: 10px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dennoko-root .unity-button.dennoko-fx-slot.dennoko-fx-slot--empty {
    color: var(--dennoko-text-tertiary);
}

.dennoko-root .dennoko-list-row.dennoko-fx-row > .unity-button.dennoko-icon-button.dennoko-fx-clear {
    margin: 0 0 0 2px;
}

/* パス不一致の注記 / 展開した参照箇所 (クリップ名の位置に揃える) */
.dennoko-root .dennoko-fx-note {
    margin: 0 4px 3px 26px;
    font-size: 10px;
    white-space: normal;
    color: var(--dennoko-semantic-warning);
}

.dennoko-root .dennoko-fx-slots {
    margin: 0 4px 3px 26px;
    padding-left: 6px;
    border-left-width: 1px;
    border-left-color: var(--dennoko-outline-subtle);
}

.dennoko-root .dennoko-fx-slot-toggle {
    margin: 1px 0;
}

.dennoko-root .dennoko-fx-slot-toggle .unity-toggle__text {
    font-size: 10px;
}

/* ホバープレビューの案内 / 再生中 (一覧の直下の 1 行。停止はアイコンボタン) */
.dennoko-root .dennoko-fx-hover-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 20px;
    margin-top: 4px;
}

.dennoko-root .dennoko-fx-hover-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dennoko-root .dennoko-fx-hover-row__playing {
    font-size: 10px;
    color: var(--dennoko-semantic-info);
}

/* 適用方法の選択肢グループは文字の幅で並べる (等幅だと「複製して適用（推奨）」が切れる) */
.dennoko-root .dennoko-field-row > .dennoko-segmented.dennoko-fx-mode-choice {
    flex-grow: 0;
}

.dennoko-root .dennoko-segmented.dennoko-fx-mode-choice > .unity-button {
    flex-grow: 0;
    flex-basis: auto;
}

/* クリップピッカー */
.dennoko-root .dennoko-fx-picker-head {
    flex-shrink: 0;
    margin-bottom: 4px;
}

.dennoko-root .dennoko-fx-picker-folder {
    flex-shrink: 0;
    margin-bottom: 4px;
}

.dennoko-root .dennoko-fx-picker-search {
    flex-shrink: 0;
    flex-grow: 0;
}

.dennoko-root .dennoko-fx-picker-empty {
    flex-shrink: 0;
    padding: 8px;
}

.dennoko-root .unity-button.dennoko-fx-picker-row {
    padding: 3px 6px;
    margin-bottom: 1px;
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    color: var(--dennoko-text-secondary);
}

.dennoko-root .unity-button.dennoko-fx-picker-row:hover {
    background-color: var(--dennoko-hover-overlay);
    color: var(--dennoko-text-primary);
}

/* ─── ポップアップ（PopupWindowContent のルート） ─────────── */

.dennoko-root .dennoko-popup-pad {
    padding: 6px;
}

/* ラベル + 入力の桁を揃えるポップアップ内フィールド */
.dennoko-root .dennoko-popup-field .unity-base-field__label {
    min-width: 90px;
}

/* ─── シェイプキーリスト (B4 リストカード) ───────────────────
   カード自体の伸び縮み・検索行・空の状態は DennokoBlocks.uss。ここは DenEmo の行の中身だけ。 */

/* ShapeKeyList.uxml の CloneTree が返す TemplateContainer（C# で付与）。置き場所の高さいっぱいに伸ばす */
.dennoko-root .dennoko-list-host {
    flex-grow: 1;
    flex-shrink: 1;
}

/* 行は ScrollView で持つ (メッシュ見出し・グループ見出し・行が混ざるため ListView ではない) */
.dennoko-root .dennoko-list-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    background-color: var(--dennoko-surface-0);
    border-width: 1px;
    border-color: var(--dennoko-outline-subtle);
    border-radius: 4px;
}

.dennoko-root .dennoko-list-scroll #unity-content-container {
    padding: 2px 0;
}

.dennoko-root .dennoko-list-scroll #unity-content-container > * {
    flex-shrink: 0;
}

.dennoko-root .dennoko-list-mesh-header {
    padding: 6px 8px 3px 8px;
}

/* グループ見出し */

.dennoko-root .dennoko-list-group-header {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 6px 0 2px;
    margin: 1px 2px;
    background-color: var(--dennoko-surface-1);
    border-radius: 3px;
}

.dennoko-root .unity-button.dennoko-icon-button.dennoko-group-fold {
    font-size: 9px;
    margin: 0 4px 0 0;
}

.dennoko-root .dennoko-group-label {
    -unity-font-style: bold;
    font-size: 11px;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.dennoko-root .dennoko-group-count {
    font-size: 10px;
    color: var(--dennoko-text-tertiary);
    margin-right: 4px;
    flex-shrink: 0;
}

/* シェイプキー行 */

.dennoko-root .dennoko-shape-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    padding: 0 4px;
    margin: 0 2px;
    border-radius: 3px;
}

.dennoko-root .dennoko-shape-row:hover {
    background-color: var(--dennoko-hover-overlay);
}

.dennoko-root .dennoko-row-indent {
    width: 18px;
    flex-shrink: 0;
}

/* 行内のアイコンボタン (☆ / 0 / ◇)。通常は控えめな色、ON はお気に入り色 */
.dennoko-root .unity-button.dennoko-icon-button.dennoko-row-icon-button {
    margin: 0;
    font-size: 12px;
    color: var(--dennoko-text-disabled);
}

.dennoko-root .unity-button.dennoko-icon-button.dennoko-row-icon-button:hover {
    color: var(--dennoko-text-secondary);
}

.dennoko-root .unity-button.dennoko-icon-button.dennoko-row-icon-button--on,
.dennoko-root .unity-button.dennoko-icon-button.dennoko-row-icon-button--on:hover {
    color: var(--dennoko-fav-active);
}

.dennoko-root .dennoko-row-include {
    margin: 0 2px;
    flex-shrink: 0;
}

.dennoko-root .dennoko-row-name {
    width: 32%;
    max-width: 200px;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
}

.dennoko-root .dennoko-row-name--dim {
    color: var(--dennoko-text-tertiary);
}

.dennoko-root .dennoko-row-slider {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 4px;
    min-height: 18px;
}

.dennoko-root .dennoko-row-slider .unity-text-field {
    width: 48px;
    flex-shrink: 0;
    margin-left: 4px;
    min-height: 18px;
}

.dennoko-root .dennoko-row-slider .unity-base-field__input {
    min-height: 18px;
    padding: 1px 3px;
}

/* ─── タイムライン ───────────────────────────────────────── */
.dennoko-root #anim-timeline-host {
    margin-bottom: 8px;
}

/* ─── 別窓タイムライン ───────────────────────────────────── */
.dennoko-root .dennoko-tlwin-notice {
    margin: 10px;
    padding: 10px;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.dennoko-root .dennoko-tlwin-scroll {
    padding-top: 8px;
    flex-grow: 1;
    flex-shrink: 1;
}

.dennoko-root .dennoko-tlwin-scroll > .unity-scroll-view__content-and-vertical-scroll-container,
.dennoko-root .dennoko-tlwin-scroll #unity-content-container {
    flex-grow: 1;
}

.dennoko-root .dennoko-tlwin-host {
    flex-grow: 1;
    flex-shrink: 1;
}

/* ─── ポップアップルート ─────────────────────────────────── */
.dennoko-root .dennoko-popup-card {
    margin-top: 8px;
}


