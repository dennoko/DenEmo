/* ============================================================
   DennokoTheme.uss
   dennokoworks フローティングデザイン (ダークテーマ固定)

   - Unity エディタのテーマ (Personal Light / Dark) に依存しない
   - カラーはすべて .dennoko-root の USS 変数を経由する
   - カラーコードのハードコーディングは変数定義部のみに限定する

   Elevation (明度差) の使い分け:
     Surface0 = 背景・文字入力欄 (沈める) / Surface1 = カード /
     Surface2 = ボタン・選択欄・ツールバー (浮かせる) / Surface3 = 浮かせた要素のホバー
   状態色の使い分け:
     accent (白) = フォーカス・Primary ボタン・チェック ON /
     selection (青) = 選択中 (排他ボタン・タブ・リスト選択行・範囲バー)

   セクション構成 (詳細度と定義順で優先度を制御するため、順序を入れ替えないこと):
     ① テキスト  ② ボタン  ③ 入力欄 (③-b 複合フィールド)  ④ トグル (④-b ラジオ)
     ⑤ Foldout  ⑥ スライダー / ProgressBar  ⑦ スクロールバー  ⑧ リスト  ⑨ HelpBox
     → 独自セマンティッククラス → ⑩ 無効状態 (必ず末尾)
   ============================================================ */

/* ─── ルート: USS 変数定義 + 最背面背景 ──────────────────── */

.dennoko-root {
    /* ニュートラル・レイヤー (サーフェス) */
    --dennoko-surface-0: #121212; /* 最背面背景 / 文字入力欄 (沈める) */
    --dennoko-surface-1: #1e1e1e; /* カード背景 */
    --dennoko-surface-2: #2c2c2c; /* ボタン・選択欄・ツールバー (浮かせる) */
    --dennoko-surface-3: #383838; /* 浮かせた要素のホバー */
    --dennoko-outline: #484848;   /* 境界線・セパレーター */
    --dennoko-outline-hover: #5e5e5e; /* 入力欄ホバー時の境界線 */

    /* タイポグラフィ */
    --dennoko-text-primary: #ffffff;   /* タイトル・強調 */
    --dennoko-text-secondary: #cccccc; /* 本文・標準ラベル */
    --dennoko-text-tertiary: #aaaaaa;  /* 補足・注記 */
    --dennoko-text-disabled: #555555;  /* 無効状態 */

    /* セマンティック (状態・警告) */
    --dennoko-semantic-error: #9b1b30;      /* エラー (塗り・枠線用) */
    --dennoko-semantic-error-text: #ff6b6b; /* エラー (文字用: 暗背景で読める明度) */
    --dennoko-semantic-warning: #ffb74d;    /* 警告 */
    --dennoko-semantic-success: #4caf50;    /* 成功 */
    --dennoko-semantic-info: #64b5f6;       /* 情報 */

    /* インタラクション */
    --dennoko-accent: #ffffff;    /* フォーカス枠・Primary ボタン・チェック ON の塗り */
    --dennoko-checkmark: #121212; /* チェックマーク / ラジオの点 (accent 塗りの上) */
    --dennoko-hover-overlay: rgba(255, 255, 255, 0.05); /* リスト行ホバー */

    /* 選択状態 (排他ボタン・タブ・リスト選択行・範囲バー)。accent とは役割を分ける */
    --dennoko-selection-border: #64b5f6;
    --dennoko-selection-bg: rgba(100, 181, 246, 0.16);
    --dennoko-selection-bg-hover: rgba(100, 181, 246, 0.26);

    /* コンポーネント派生色 */
    --dennoko-list-alt-bg: rgba(255, 255, 255, 0.025);  /* リスト交互行 (ごくわずかな差) */
    --dennoko-progress-fill: rgba(100, 181, 246, 0.55); /* ProgressBar の塗り (白文字が読める明度) */

    /* ステータス / HelpBox 用の派生色 (semantic 色を暗背景に馴染ませたもの) */
    --dennoko-status-success-bg: rgba(76, 175, 80, 0.25);
    --dennoko-status-error-bg: rgba(155, 27, 48, 0.45);
    --dennoko-status-error-text: #ffa6a6; /* 赤背景の上で読める明度に調整したエラー文字色 */
    --dennoko-status-warning-bg: rgba(255, 183, 77, 0.12);
    --dennoko-status-info-bg: rgba(100, 181, 246, 0.12);

    background-color: var(--dennoko-surface-0);
    flex-grow: 1;
}

/* ─── ① テキスト要素の強制リセット ───────────────────────
   Unity のすべてのテキスト要素の色を上書きし、
   Personal Light テーマの黒文字が混入しないようにする。 */

.dennoko-root .unity-text-element {
    color: var(--dennoko-text-secondary);
}

.dennoko-root .dennoko-text-primary {
    color: var(--dennoko-text-primary);
}

.dennoko-root .dennoko-text-tertiary {
    color: var(--dennoko-text-tertiary);
}

.dennoko-root .dennoko-text-disabled {
    color: var(--dennoko-text-disabled);
}

/* セマンティックテキスト
   ⚠ エラー文字に --dennoko-semantic-error (#9b1b30) を使うと暗背景でほぼ読めない。
   文字には明度を上げた --dennoko-semantic-error-text を使う。 */
.dennoko-root .dennoko-text-error   { color: var(--dennoko-semantic-error-text); }
.dennoko-root .dennoko-text-warning { color: var(--dennoko-semantic-warning); }
.dennoko-root .dennoko-text-success { color: var(--dennoko-semantic-success); }
.dennoko-root .dennoko-text-info    { color: var(--dennoko-semantic-info); }

/* ─── ② ボタンの強制リセット ─────────────────────────────
   エディタテーマ由来の境界線・グラデーションを遮断し、
   フラットな dennokoworks デザインに固定する。
   ボタンは「押せる = 浮いている」ため Surface2 に置く (文字入力欄は Surface0 に沈める)。 */

.dennoko-root .unity-button {
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
    color: var(--dennoko-text-primary);
    padding: 3px 12px;
    margin: 2px 4px;
    /* 同じ行に並ぶボタンの高さを揃える (バリアントは文字サイズ・色だけで差を付ける) */
    min-height: 26px;
    -unity-text-align: middle-center;
}

.dennoko-root .unity-button:hover {
    background-color: var(--dennoko-surface-3);
}

.dennoko-root .unity-button:active {
    background-color: var(--dennoko-surface-3);
    border-color: var(--dennoko-accent);
}

.dennoko-root .unity-button:disabled {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-surface-2);
    color: var(--dennoko-text-disabled);
}

/* ボタンバリアント
   ※ .unity-button を連結して詳細度を (0,3,0) にし、上の汎用リセット
   .dennoko-root .unity-button (0,2,0) や :hover (0,3,0) に確実に勝たせる。
   USS に !important は存在しないため、詳細度と定義順(同数は後勝ち)で解決する。 */

/* Primary Action ボタン (Apply & Save 等)
   画面内で最優先のアクションなので accent (白) で塗り、文字は暗色にする。 */
.dennoko-root .unity-button.dennoko-button-primary {
    background-color: var(--dennoko-accent);
    border-color: var(--dennoko-accent);
    color: var(--dennoko-surface-0);
    -unity-font-style: bold;
    font-size: 13px;
    height: 34px;
}

.dennoko-root .unity-button.dennoko-button-primary:hover {
    background-color: var(--dennoko-text-secondary);
    border-color: var(--dennoko-text-secondary);
}

.dennoko-root .unity-button.dennoko-button-primary:active {
    background-color: var(--dennoko-text-tertiary);
    border-color: var(--dennoko-accent);
}

/* 無効時は accent 塗りをやめる (汎用 :disabled (0,3,0) より詳細度を上げる) */
.dennoko-root .unity-button.dennoko-button-primary:disabled {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-surface-2);
    color: var(--dennoko-text-disabled);
}

/* Secondary Action ボタン (Reset All 等)。高さは汎用ボタンと同じにし、文字で差を付ける */
.dennoko-root .unity-button.dennoko-button-secondary {
    font-size: 11px;
    color: var(--dennoko-text-secondary);
}

.dennoko-root .unity-button.dennoko-button-secondary:hover {
    color: var(--dennoko-text-primary);
}

/* Toggle ボタン型のアクティブ状態用 (ON/OFF 切り替えボタン・排他選択・タブ等)
   青枠 + 青ティント背景で「選択中」を明示する。色は accent ではなく
   --dennoko-selection-* を使う (accent = フォーカス・最優先アクション、selection = 選択中)。
   :hover / :active でも青枠を維持する (維持しないと汎用の .unity-button:active が
   accent の白枠で上書きしてしまう)。 */
.dennoko-root .unity-button.dennoko-button-active {
    background-color: var(--dennoko-selection-bg);
    border-color: var(--dennoko-selection-border);
    border-width: 1px;
    color: var(--dennoko-text-primary);
    -unity-font-style: bold;
}
.dennoko-root .unity-button.dennoko-button-active:hover {
    background-color: var(--dennoko-selection-bg-hover);
    border-color: var(--dennoko-selection-border);
}
.dennoko-root .unity-button.dennoko-button-active:active {
    border-color: var(--dennoko-selection-border);
}

/* ─── ③ 入力フィールドのリセット ─────────────────────────
   TextField / IntegerField / FloatField / DropdownField / EnumField /
   ObjectField など、.unity-base-field__input を持つすべてに適用される。
   文字入力欄は「沈める」ため Surface0 に置く (カード Surface1 より暗い)。 */

/* ラベル列の幅を揃える (label= 指定の Toggle も他の入力欄と同じ 2 カラムにする) */
.dennoko-root .unity-base-field > .unity-base-field__label {
    min-width: 150px;
}

/* ボックススタイル (背景・枠・パディング) は外側の __input のみに適用する */
.dennoko-root .unity-base-field__input {
    background-color: var(--dennoko-surface-0);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
    color: var(--dennoko-text-primary);
    padding: 3px 6px;
}

/* 内側のテキスト要素には color のみを適用する。
   ⚠ ボックススタイルを内側にも掛けるとフィールド内部に二重の枠・
   二重のパディングが生まれてレイアウトが崩れる。
   Light テーマの黒文字上書きは、この子孫セレクタの詳細度 (0,3,0) で防ぐ
   (USS に !important は存在しない)。 */
.dennoko-root .unity-base-field__input .unity-text-element,
.dennoko-root .unity-object-field__input .unity-object-field-display__label {
    color: var(--dennoko-text-primary);
}

/* 沈めた入力欄のホバーは背景ではなく枠線の明度で示す */
.dennoko-root .unity-base-field:hover .unity-base-field__input {
    border-color: var(--dennoko-outline-hover);
}

/* フォーカスは内側のテキスト入力要素に移るため、両方の書き方でカバーする */
.dennoko-root .unity-base-field:focus .unity-base-field__input,
.dennoko-root .unity-base-field__input:focus {
    border-color: var(--dennoko-accent);
}

/* 選択欄 (Dropdown / Enum / Mask / Layer / Tag 等) は「押して選ぶ」ので
   ボタンと同じ Surface2 に浮かせ、文字入力欄と見分けられるようにする */
.dennoko-root .unity-base-popup-field > .unity-base-field__input,
.dennoko-root .unity-enum-field > .unity-base-field__input {
    background-color: var(--dennoko-surface-2);
}

.dennoko-root .unity-base-popup-field:hover > .unity-base-field__input,
.dennoko-root .unity-enum-field:hover > .unity-base-field__input {
    background-color: var(--dennoko-surface-3);
}

/* 読み取り専用 (独自クラス。readonly="true" の TextField 等に併せて付ける)
   ※ Unity 2022.3 には読み取り専用を示すビルトインクラスがないため明示する */
.dennoko-root .dennoko-field-readonly > .unity-base-field__input,
.dennoko-root .dennoko-field-readonly:hover > .unity-base-field__input,
.dennoko-root .dennoko-field-readonly:focus > .unity-base-field__input,
.dennoko-root .dennoko-field-readonly > .unity-base-field__input:focus {
    background-color: transparent;
    border-color: var(--dennoko-surface-2);
}

.dennoko-root .dennoko-field-readonly > .unity-base-field__input .unity-text-element {
    color: var(--dennoko-text-tertiary);
}

/* 複数行入力 (独自クラス。multiline="true" の TextField に併せて付ける)
   ラベルを入力欄 1 行目のベースラインに揃える (入力欄の padding-top + border ぶん下げる) ※要実機確認 */
.dennoko-root .dennoko-field-multiline > .unity-base-field__label {
    padding-top: 5px;
}

/* テキストキャレットと選択範囲の色
   (Light テーマでは黒キャレットになり、暗い入力欄で見えなくなる) ※要実機確認 */
.dennoko-root .unity-base-text-field__input {
    --unity-cursor-color: var(--dennoko-text-primary);
    --unity-selection-color: rgba(100, 181, 246, 0.4);
}

/* ドロップダウンの矢印アイコン
   ⚠ tint は「乗算」のため、Light テーマの黒い矢印画像は明るくできない。
   ダークスキン用 (d_ 接頭辞) のビルトインアイコンを明示指定して
   画像自体をテーマ非依存にする。※アイコン名は要実機確認
   (references/troubleshooting.md 参照) */
.dennoko-root .unity-base-popup-field__arrow,
.dennoko-root .unity-enum-field__arrow {
    background-image: resource("d_dropdown");
    -unity-background-image-tint-color: var(--dennoko-text-secondary);
}

/* ObjectField のセレクタボタン
   ⚠ tint は乗算 — Light テーマでピッカーアイコンが見えない場合は
   上記の矢印と同様に background-image へ d_ 系アイコンを明示指定する */
.dennoko-root .unity-object-field__selector {
    background-color: var(--dennoko-surface-2);
    -unity-background-image-tint-color: var(--dennoko-text-secondary);
}

/* ColorField / GradientField / CurveField
   内側のプレビューが上に寄って下に隙間ができる・角丸からはみ出すため、
   パディングを詰めて中央に揃え、角丸でクリップする */
.dennoko-root .unity-color-field > .unity-base-field__input,
.dennoko-root .unity-gradient-field > .unity-base-field__input {
    padding: 2px;
    align-items: center;
    overflow: hidden;
}

.dennoko-root .unity-curve-field > .unity-base-field__input {
    padding: 3px;
    overflow: hidden;
}

/* ─── ③-b 複合フィールド (Vector2/3/4・Rect・Bounds) ─────────
   親の __input にも③のボックスが乗り「全体枠 > 各数値枠」の二重枠
   (BoundsField では三重枠) になるため、親側の枠を消して末端の数値欄だけに枠を出す。 */

.dennoko-root .unity-composite-field > .unity-base-field__input,
.dennoko-root .unity-composite-field:hover > .unity-base-field__input,
.dennoko-root .unity-composite-field:focus > .unity-base-field__input,
.dennoko-root .unity-bounds-field > .unity-base-field__input,
.dennoko-root .unity-bounds-field:hover > .unity-base-field__input,
.dennoko-root .unity-bounds-field:focus > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

/* BoundsField 内の Vector3Field は、外側 (Bounds) のホバーでも背景を出さない */
.dennoko-root .unity-base-field:hover .unity-composite-field > .unity-base-field__input {
    background-color: transparent;
}

/* 各サブフィールド (X / Y / Z ...) で横幅を均等に分割する。
   ペアの間 (ラベル→数値) は狭く、ペア同士の間は広く取ってグルーピングを明確にする */
.dennoko-root .unity-composite-field__field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 8px;
    margin-right: 0;
}

.dennoko-root .unity-composite-field__field--first {
    margin-left: 0;
}

.dennoko-root .unity-composite-field__field > .unity-base-field__label {
    min-width: 0;
    flex-shrink: 0;
    margin-right: 3px;
    padding-left: 0;
}

.dennoko-root .unity-composite-field__field > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* BoundsField: 他のフィールドと同じ「左ラベル列 + 右入力列」の 2 カラムに揃え、
   Center / Extents のラベル幅を固定して X/Y/Z の縦ラインを揃える */
.dennoko-root .unity-bounds-field {
    flex-direction: row;
}

/* メインラベルは 1 段目 (Center 行) の文字のベースラインに揃える
   (内側の Vector3Field / FloatField の上マージン + 入力欄の padding + border ぶん下げる) */
.dennoko-root .unity-bounds-field > .unity-base-field__label {
    align-self: flex-start;
    padding-top: 6px;
}

/* align-items: stretch で Center / Extents の 2 行を右端まで確実に広げる */
.dennoko-root .unity-bounds-field > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    align-items: stretch;
    margin-left: 0;
}

/* Center 行と Extents 行の間に通常のフィールド行間ぶんの隙間を取る */
.dennoko-root .unity-bounds-field .unity-composite-field {
    margin-top: 0;
    margin-bottom: 3px;
}

/* Center / Extents のサブラベル
   ⚠ ビルトイン USS の padding-left / margin が残ると、固定幅の中が空白で埋まり
   文字が右へはみ出して X ラベルと重なる (CXen / EXxte のように見える)。
   幅は X/Y/Z の入力欄を広く取れるよう 48px に抑え、余白はすべて明示的に打ち消す。 */
.dennoko-root .unity-bounds-field .unity-composite-field > .unity-base-field__label {
    min-width: 48px;
    width: 48px;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 4px;
    margin-left: 0;
    margin-right: 0;
    -unity-text-align: middle-left;
}

/* ─── ④ トグル (Toggle) のチェックボックスリセット ────────
   ⚠ エディタスキンのチェック画像は「箱 + チェック」が一体のため、
   tint (乗算) すると箱ごと暗く塗り潰されてしまう。
   箱込み画像は破棄して背景色で箱を描き、チェックマークには
   グリフのみのビルトインアイコンを明示指定する。
   OFF = 暗色の箱 + 枠線のみ / ON = accent (白) 塗り + 暗色チェック。
   (OFF も白塗りにすると ON と見分けがつかない) */

/* Toggle の入力コンテナ (.unity-toggle__input) は .unity-base-field__input でも
   あるため、③の入力フィールド装飾がそのまま乗り、チェックボックス + ラベル全体が
   入力欄のような箱で囲まれてしまう。
   ⚠ トグルは「入力欄」ではなくテキスト行として見せる。囲みは付けない。
   :hover / :focus も併記するのは、③の疑似クラス付きセレクタ (0,4,0) のほうが
   詳細度が高く、素の打ち消し (0,3,0) だけではホバー時に負けるため。 */
.dennoko-root .unity-toggle .unity-base-field__input,
.dennoko-root .unity-toggle:hover .unity-base-field__input,
.dennoko-root .unity-toggle:focus .unity-base-field__input,
.dennoko-root .unity-toggle .unity-base-field__input:focus {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
}

/* Toggle の text は .unity-base-field__input の「内側」に Label として生成される。
   ⚠ ③で内側のテキスト要素にボックススタイル (背景・枠・角丸・パディング) を
   足すと、ラベル文字が箱で囲まれる。③は color のみに留めること。
   ここでは念のため打ち消しつつ、チェックボックスとの間隔だけを与える。 */
.dennoko-root .unity-toggle .unity-toggle__text {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    margin-left: 4px;
}

/* OFF: 暗色の箱 + 枠線のみ */
.dennoko-root .unity-toggle .unity-toggle__checkmark {
    background-color: var(--dennoko-surface-0);
    background-image: none;                  /* スキンの箱込み画像を破棄 */
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 3px;
}

.dennoko-root .unity-toggle:hover .unity-toggle__checkmark {
    border-color: var(--dennoko-text-tertiary);
}

/* ON: 白塗り + 暗色のチェックグリフ (白 × 暗色の乗算なのでテーマ非依存でクッキリ見える) */
.dennoko-root .unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--dennoko-accent);
    border-color: var(--dennoko-accent);
    background-image: resource("d_checkmark");
    -unity-background-image-tint-color: var(--dennoko-checkmark);
    /* 箱いっぱいに描くと線が太く重く見えるため、少し小さく表示する
       (線幅は画像に焼き込まれており、縮小でしか細くできない)。 */
    background-size: 80% 80%;
}

/* ─── ④-b ラジオボタン (RadioButton / RadioButtonGroup) ───────
   Toggle と同じく入力欄の箱を打ち消し、丸いインジケーターだけを描く。
   グループ全体の外枠と各選択肢の枠はどちらも付けない。 */

.dennoko-root .unity-radio-button-group > .unity-base-field__input,
.dennoko-root .unity-radio-button-group:hover > .unity-base-field__input,
.dennoko-root .unity-radio-button-group:focus > .unity-base-field__input,
.dennoko-root .unity-radio-button .unity-base-field__input,
.dennoko-root .unity-radio-button:hover .unity-base-field__input,
.dennoko-root .unity-radio-button:focus .unity-base-field__input,
.dennoko-root .unity-radio-button .unity-base-field__input:focus,
.dennoko-root .unity-base-field:hover .unity-radio-button .unity-base-field__input {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
}

.dennoko-root .unity-radio-button .unity-radio-button__text {
    margin-left: 4px;
}

/* OFF: 暗色の丸 + 枠線 */
.dennoko-root .unity-radio-button .unity-radio-button__checkmark-background {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--dennoko-outline);
    background-color: var(--dennoko-surface-0);
    background-image: none;
    justify-content: center;
    align-items: center;
}

.dennoko-root .unity-radio-button:hover .unity-radio-button__checkmark-background {
    border-color: var(--dennoko-text-tertiary);
}

.dennoko-root .unity-radio-button .unity-radio-button__checkmark {
    width: 6px;
    height: 6px;
    margin: 0;
    border-radius: 3px;
    background-image: none;
    background-color: transparent;
}

/* ON: 白い丸 + 暗色の点 */
.dennoko-root .unity-radio-button:checked .unity-radio-button__checkmark-background {
    background-color: var(--dennoko-accent);
    border-color: var(--dennoko-accent);
}

.dennoko-root .unity-radio-button:checked .unity-radio-button__checkmark {
    background-color: var(--dennoko-checkmark);
}

/* ─── ⑤ フォールドアウト (Foldout) ───────────────────────── */

.dennoko-root .unity-foldout__toggle {
    background-color: var(--dennoko-surface-1);
    margin: 2px 0;
    padding: 4px;
    border-radius: 4px;
}

.dennoko-root .unity-foldout__content {
    margin-left: 15px;
    padding: 6px;
    border-left-width: 1px;
    border-left-color: var(--dennoko-outline);
}

/* Foldout の展開矢印は Toggle のチェックマーク要素を流用しているため、
   上記④のチェックボックス装飾 (背景・枠・checked 時の白背景) を打ち消し、
   矢印画像の色だけを固定する。
   ⚠ このリセットがないと、矢印が白い四角の箱として表示されてしまう。 */
.dennoko-root .unity-foldout__toggle .unity-toggle__checkmark,
.dennoko-root .unity-foldout__toggle:checked .unity-toggle__checkmark,
.dennoko-root .unity-foldout__toggle:hover .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
    background-size: initial; /* ④ のチェックマーク縮小を展開矢印に持ち込まない */
    -unity-background-image-tint-color: var(--dennoko-text-secondary);
}

/* ④ で箱込みのチェック画像を破棄した (background-image: none) ため、
   展開矢印はビルトインアイコンを明示指定して復元する。
   d_ 系を指定することでテーマ非依存にもなる。※アイコン名は要実機確認 */
.dennoko-root .unity-foldout__toggle .unity-toggle__checkmark {
    background-image: resource("IN foldout");
}

.dennoko-root .unity-foldout__toggle:checked .unity-toggle__checkmark {
    background-image: resource("IN foldout on");
}

/* ─── ⑥ スライダー ─────────────────────────────────────────
   スライダーは文字入力欄ではないので、③の入力欄ボックスを打ち消して
   「レール + つまみ + (右端の数値入力欄)」だけの構成にする。
   (枠を残すと数値入力欄と二重枠になり、入力欄の有無で行の高さも揃わない) */

.dennoko-root .unity-base-slider > .unity-base-field__input,
.dennoko-root .unity-base-slider:hover > .unity-base-field__input,
.dennoko-root .unity-base-slider:focus > .unity-base-field__input,
.dennoko-root .unity-min-max-slider > .unity-base-field__input,
.dennoko-root .unity-min-max-slider:hover > .unity-base-field__input,
.dennoko-root .unity-min-max-slider:focus > .unity-base-field__input {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
}

.dennoko-root .unity-base-slider--horizontal > .unity-base-field__input {
    padding: 0 4px;
}

/* 縦スライダーはレールとつまみの中心を揃えるため左右の余白を持たせない */
.dennoko-root .unity-base-slider--vertical > .unity-base-field__input {
    padding: 0;
}

/* 数値入力欄の有無で行の高さが変わらないよう、行の最小高さと入力欄の余白を揃える ※要実機確認 */
.dennoko-root .unity-base-slider {
    min-height: 24px;
}

.dennoko-root .unity-base-slider__text-field {
    margin-top: 0;
    margin-bottom: 0;
}

.dennoko-root .unity-base-slider__text-field > .unity-base-field__input {
    padding: 2px 4px;
}

.dennoko-root .unity-base-slider__tracker {
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 2px;
}

.dennoko-root .unity-base-slider__dragger {
    background-color: var(--dennoko-text-secondary);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
}

.dennoko-root .unity-base-slider__dragger:hover {
    background-color: var(--dennoko-text-primary);
}

/* MinMaxSlider (範囲スライダー)
   ⚠ スキンの範囲バーは 9-slice 画像のため、引き伸ばすと両端の色が
   間延びして見える。画像を破棄してフラットな塗りに置き換える。 */
.dennoko-root .unity-min-max-slider .unity-base-field__input,
.dennoko-root .unity-min-max-slider__input {
    height: 28px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.dennoko-root .unity-min-max-slider__tracker {
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 2px;
}

/* 範囲バーは「選択範囲」なので selection 色にし、白いつまみと明度差を付ける */
.dennoko-root .unity-min-max-slider__dragger {
    background-image: none;
    background-color: var(--dennoko-selection-border);
    border-width: 0;
    border-radius: 2px;
}

/* 両端のつまみは範囲部分より明るくして掴める位置を示す */
.dennoko-root .unity-min-max-slider__min-thumb,
.dennoko-root .unity-min-max-slider__max-thumb {
    background-image: none;
    background-color: var(--dennoko-text-primary);
    border-width: 0;
    border-radius: 2px;
}

/* ProgressBar: 他のパーツと同じ角丸 + 枠線にし、塗りはパレット由来の青にする */
.dennoko-root .unity-progress-bar__background {
    background-color: var(--dennoko-surface-0);
    border-width: 1px;
    border-color: var(--dennoko-outline);
    border-radius: 4px;
    overflow: hidden;
}

.dennoko-root .unity-progress-bar__progress {
    background-color: var(--dennoko-progress-fill);
    border-radius: 0;
}

.dennoko-root .unity-progress-bar__title {
    color: var(--dennoko-text-primary);
}

/* ─── ⑦ スクロールバー ───────────────────────────────────── */

.dennoko-root .unity-scroller {
    background-color: var(--dennoko-surface-0);
    border-color: var(--dennoko-outline);
}

/* ⚠ tint は乗算 — Light テーマで矢印が見えない場合は
   ドロップダウン矢印と同様に background-image へ d_ 系アイコンを明示指定する */
.dennoko-root .unity-scroller__low-button,
.dennoko-root .unity-scroller__high-button {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    -unity-background-image-tint-color: var(--dennoko-text-secondary);
}

/* ⚠ スクロールバー内部の要素にボタン・入力欄・スライダーの汎用リセット
   (padding / margin / 枠線 / 最小高さ) を波及させない。波及するとレーン幅を超えて
   要素がはみ出し、縦バーでは中身が右寄りに、横バーでは上下ずれとして
   現れる。詳細度 (0,3,0) で汎用リセット (0,2,0) を打ち消す。 */
.dennoko-root .unity-scroller .unity-button {
    padding: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    min-height: 0;
}

.dennoko-root .unity-scroller .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.dennoko-root .unity-scroller .unity-base-slider {
    min-height: 0;
}

.dennoko-root .unity-scroller .unity-base-slider__tracker {
    background-color: var(--dennoko-surface-0);
    border-width: 0;
    border-radius: 0;
}

/* つまみは控えめな明度にし、ホバー時だけ明るくする */
.dennoko-root .unity-scroller .unity-base-slider__dragger {
    background-color: var(--dennoko-text-disabled);
    border-width: 0;
    border-radius: 4px;
}

.dennoko-root .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--dennoko-text-tertiary);
}

/* ─── ⑧ リスト (ListView / TreeView 等の CollectionView) ─────
   交互行の明度差はごくわずかに抑え、ホバー・選択行がはっきり際立つようにする。
   (差が大きいと交互行がすべて選択中・ホバー中に見える) */

.dennoko-root .unity-collection-view .unity-collection-view__item {
    background-color: transparent;
}

.dennoko-root .unity-collection-view .unity-collection-view__item--alternative-background {
    background-color: var(--dennoko-list-alt-bg);
}

.dennoko-root .unity-collection-view .unity-collection-view__item:hover {
    background-color: var(--dennoko-hover-overlay);
}

.dennoko-root .unity-collection-view .unity-collection-view__item.unity-collection-view__item--selected,
.dennoko-root .unity-collection-view:focus .unity-collection-view__item.unity-collection-view__item--selected {
    background-color: var(--dennoko-selection-bg);
}

.dennoko-root .unity-collection-view .unity-collection-view__item--selected,
.dennoko-root .unity-collection-view .unity-collection-view__item--selected .unity-text-element {
    color: var(--dennoko-text-primary);
}

/* ─── ⑨ HelpBox ─────────────────────────────────────────────
   アイコンなし (MessageType.None) でも潰れないよう最小高さと余白を持たせる。
   種類別の色分けは .dennoko-helpbox--info / --warning / --error を併せて付ける
   (HelpBox ルート要素には種類を示すビルトインクラスがないため)。 */

.dennoko-root .unity-help-box {
    background-color: var(--dennoko-surface-2);
    border-width: 1px;
    border-color: var(--dennoko-outline);
    border-radius: 4px;
    min-height: 28px;
    padding: 6px 10px;
    margin: 2px 0 6px 0;
    align-items: center;
}

.dennoko-root .unity-help-box.dennoko-helpbox--info {
    background-color: var(--dennoko-status-info-bg);
    border-color: var(--dennoko-semantic-info);
}

.dennoko-root .unity-help-box.dennoko-helpbox--warning {
    background-color: var(--dennoko-status-warning-bg);
    border-color: var(--dennoko-semantic-warning);
}

.dennoko-root .unity-help-box.dennoko-helpbox--error {
    background-color: var(--dennoko-status-error-bg);
    border-color: var(--dennoko-semantic-error);
}

.dennoko-root .unity-help-box.dennoko-helpbox--error .unity-text-element {
    color: var(--dennoko-status-error-text);
}

/* ─── フローティングデザイン用セマンティッククラス ─────────
   以下は Unity ビルトインではなく dennokoworks 独自のクラス。
   UXML 側で class 属性として付与して使う。

   【規約】セレクタは必ず .dennoko-root を前置する。
   前置しない (0,1,0) と、上記の汎用リセット
   .dennoko-root .unity-text-element / .unity-button (0,2,0) に
   color 宣言が詳細度で負けてしまう。USS に !important は存在しないため、
   「.dennoko-root 前置 (0,2,0) + リセットより後方に定義 (同数は後勝ち)」で勝たせる。 */

/* セクションカード */
.dennoko-root .dennoko-card {
    background-color: var(--dennoko-surface-1);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 8px;
    padding: 12px;
    margin: 0 8px 10px 8px;
}

/* カード内ヘッダー */
.dennoko-root .dennoko-card-header {
    border-bottom-width: 1px;
    border-bottom-color: var(--dennoko-outline);
    padding-bottom: 6px;
    margin-bottom: 10px;
}

/* トグル付きヘッダー (Toggle と Reset ボタンを横並びにする) */
.dennoko-root .dennoko-toggle-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* トグル付きヘッダー内のボタン (Reset 等) はウィンドウ縮小時にも潰さない */
.dennoko-root .dennoko-toggle-header > .unity-button {
    flex-shrink: 0;
}

/* トグル付きセクションの折りたたみ
   トグル OFF のとき、C# がカードに .dennoko-toggle-section--collapsed を付ける。
   中身 (.dennoko-toggle-section__content) を非表示にし、見出しの下線と余白も消して
   見出し行だけのコンパクトなカードにする (グレーアウトではなく折りたたむ)。 */
.dennoko-root .dennoko-toggle-section--collapsed > .dennoko-toggle-section__content {
    display: none;
}

.dennoko-root .dennoko-toggle-section--collapsed > .dennoko-card-header {
    border-bottom-width: 0;
    padding-bottom: 0;
    margin-bottom: 0;
}

/* ウィンドウヘッダー行
   (固定クロームには flex-shrink: 0 を付け、ウィンドウ縮小時は
   .dennoko-scroll のスクロール領域だけが縮むようにする) */
.dennoko-root .dennoko-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    flex-shrink: 0;
}

/* ウィンドウタイトル */
.dennoko-root .dennoko-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
}

/* ヘッダー左側: タイトル + バージョンをまとめる行
   (references/version-check-guide.md 参照) */
.dennoko-root .dennoko-header-titlegroup {
    flex-direction: row;
    align-items: center;
}

/* バージョン表記 (タイトル横の小さな補足テキスト) */
.dennoko-root .dennoko-version-label {
    font-size: 10px;
    margin-left: 6px;
    color: var(--dennoko-text-tertiary);
}
/* 更新あり (目立たせるため鮮やかな緑) */
.dennoko-root .dennoko-version-label--update {
    color: var(--dennoko-semantic-success);
    -unity-font-style: bold;
}
/* 最新版の取得に失敗 */
.dennoko-root .dennoko-version-label--error {
    color: var(--dennoko-semantic-warning);
}

/* バージョン再確認ボタン (↻)
   20px 角のアイコンボタン。通常時は枠を見せず、ホバーで枠と背景を出して
   クリック領域を示す。汎用ボタンの min-height (26px) を打ち消す。
   (references/version-check-guide.md 参照) */
.dennoko-root .dennoko-version-reload-button {
    width: 20px;
    height: 20px;
    min-height: 0;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--dennoko-text-tertiary);
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 4px;
}
.dennoko-root .dennoko-version-reload-button:hover {
    color: var(--dennoko-text-primary);
    background-color: var(--dennoko-surface-2);
    border-color: var(--dennoko-outline);
}

/* セクション見出し (大文字英字を想定した小さめの見出し)
   ※ Toggle に付与した場合、文字は子要素 (.unity-toggle__text) にあり、
   汎用リセット .dennoko-root .unity-text-element が子要素に「直接」マッチして
   継承色より優先されるため、子孫セレクタも併記して色を届かせる */
.dennoko-root .dennoko-section-title,
.dennoko-root .dennoko-section-title .unity-text-element {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--dennoko-text-tertiary);
}

/* セパレーター (水平線) */
.dennoko-root .dennoko-separator {
    height: 1px;
    background-color: var(--dennoko-outline);
    margin: 4px 0;
    flex-shrink: 0;
}

/* メインのスクロール領域 (ScrollView に付与する)
   ウィンドウ縮小時はこの領域だけが縮む */
.dennoko-root .dennoko-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

/* 横並び行 (伸びる入力欄 + 固定幅ボタン等)。折り返さない */
.dennoko-root .dennoko-hrow {
    flex-direction: row;
    align-items: center;
}

/* 伸びて縮む子要素。⚠ flex-grow だけでは幅が足りないときに縮まず、
   隣のボタンが枠外へ押し出される。flex-shrink と必ずセットで指定する
   (references/uss-conventions.md §5) */
.dennoko-root .dennoko-col-grow {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* メインのスクロールバーとカード右端の間に余白を作る
   (子孫セレクタにすると ListView 等の入れ子 ScrollView にも波及するため子セレクタで限定) */
.dennoko-root .dennoko-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__vertical-scroller {
    margin-left: 4px;
}

/* フッター (アクションボタン領域)
   カードで囲まず、上罫線だけでスクロール領域と仕切る (枠線の多重化を避ける)。
   ボタンは 1 行に並べ、左に固定幅の Secondary、右に伸びる Primary を置く。 */
.dennoko-root .dennoko-footer {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 8px 4px;
    border-top-width: 1px;
    border-top-color: var(--dennoko-outline);
    background-color: var(--dennoko-surface-0);
}

.dennoko-root .dennoko-footer > .unity-button {
    height: 32px;
}

.dennoko-root .dennoko-footer > .unity-button.dennoko-button-secondary {
    width: 96px;
    flex-shrink: 0;
}

.dennoko-root .dennoko-footer > .unity-button.dennoko-button-primary {
    flex-grow: 1;
    flex-shrink: 1;
}

/* ツールバー行
   ⚠ カード上端に密着させる場合、カードの padding (12px) と角丸 (8px) を
   はみ出す。カード側に overflow: hidden を付けるか、ツールバー側に
   margin: -12px -12px 8px -12px; border-radius: 8px 8px 0 0; を指定する */
.dennoko-root .dennoko-toolbar {
    flex-direction: row;
    align-items: center;
    background-color: var(--dennoko-surface-2);
    padding: 4px 6px;
}

/* ツールバー内のボタンは Surface2 の上に乗るため、枠を見せないゴースト表示にする */
.dennoko-root .dennoko-toolbar > .unity-button {
    background-color: transparent;
    border-color: transparent;
    min-height: 22px;
    margin: 0 2px;
    padding: 2px 8px;
}

.dennoko-root .dennoko-toolbar > .unity-button:hover {
    background-color: var(--dennoko-surface-3);
}

.dennoko-root .dennoko-toolbar > .unity-button.dennoko-button-active {
    background-color: var(--dennoko-selection-bg);
    border-color: var(--dennoko-selection-border);
}

.dennoko-root .dennoko-toolbar > .unity-button.dennoko-button-active:hover {
    background-color: var(--dennoko-selection-bg-hover);
}

/* ステータスバー (枠線は付けず、背景の明度差だけで区切る) */
.dennoko-root .dennoko-status {
    background-color: var(--dennoko-surface-1);
    border-width: 0;
    border-radius: 4px;
    color: var(--dennoko-text-secondary);
    font-size: 11px;
    padding: 5px 8px;
    margin: 0 8px 8px 8px;
    white-space: normal;
    flex-shrink: 0;
}

.dennoko-root .dennoko-status--success {
    background-color: var(--dennoko-status-success-bg);
    color: var(--dennoko-semantic-success);
}

.dennoko-root .dennoko-status--error {
    background-color: var(--dennoko-status-error-bg);
    color: var(--dennoko-status-error-text);
}

/* Inspector 用ルート:
   InspectorElement 既定の左右余白を打ち消し、Surface0 を全幅に塗る。
   ルート要素自身に dennoko-root と一緒に付与するため、連結セレクタで書く
   (子孫セレクタではない点に注意)。
   余白量は Unity バージョンによって異なるため、はみ出し・隙間が出る場合は
   margin の値を調整すること。 */
.dennoko-root.dennoko-inspector-root {
    margin-left: -15px;
    margin-right: -6px;
    padding: 8px 12px;
}

/* ─── ⑩ 無効状態 (:disabled) ─────────────────────────────────
   SetEnabled(false) された要素とその子孫すべてに :disabled が付く。
   コンポーネントごとに無効時のトーンがばらつかないよう、文字・枠・塗りを一律に落とす。
   ⚠ .unity-disabled に opacity を掛けると、子孫にも同じクラスが付くため
   入れ子の段数だけ透明度が掛け算になる。opacity ではなく色で表現する。
   ⚠ 通常状態・ホバー状態のルールに勝つよう、このセクションはファイル末尾に置く。 */

.dennoko-root .unity-text-element:disabled,
.dennoko-root .unity-base-field__input .unity-text-element:disabled,
.dennoko-root .unity-object-field__input .unity-object-field-display__label:disabled {
    color: var(--dennoko-text-disabled);
}

/* 入力欄の枠を一段暗くする (Toggle / Slider 等は border-width: 0 のため見た目に影響しない) */
.dennoko-root .unity-base-field:disabled .unity-base-field__input,
.dennoko-root .unity-base-field:disabled:hover .unity-base-field__input {
    border-color: var(--dennoko-surface-2);
}

.dennoko-root .unity-base-popup-field:disabled > .unity-base-field__input,
.dennoko-root .unity-enum-field:disabled > .unity-base-field__input {
    background-color: var(--dennoko-surface-1);
}

.dennoko-root .unity-base-field:disabled .unity-base-popup-field__arrow,
.dennoko-root .unity-base-field:disabled .unity-enum-field__arrow,
.dennoko-root .unity-base-field:disabled .unity-object-field__selector {
    -unity-background-image-tint-color: var(--dennoko-text-disabled);
}

/* チェックボックス: OFF = 暗い枠のみ / ON = グレー塗り (無効でも ON/OFF を判別できる) */
.dennoko-root .unity-toggle:disabled .unity-toggle__checkmark {
    border-color: var(--dennoko-surface-2);
}

.dennoko-root .unity-toggle:disabled:checked .unity-toggle__checkmark {
    background-color: var(--dennoko-text-disabled);
    border-color: var(--dennoko-text-disabled);
}

/* Foldout の展開矢印には上のチェックボックス無効表示を持ち込まない */
.dennoko-root .unity-foldout__toggle:disabled .unity-toggle__checkmark,
.dennoko-root .unity-foldout__toggle:disabled:checked .unity-toggle__checkmark {
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: var(--dennoko-text-disabled);
}

.dennoko-root .unity-radio-button:disabled .unity-radio-button__checkmark-background {
    border-color: var(--dennoko-surface-2);
}

.dennoko-root .unity-radio-button:disabled:checked .unity-radio-button__checkmark-background {
    background-color: var(--dennoko-text-disabled);
    border-color: var(--dennoko-text-disabled);
}

.dennoko-root .unity-base-slider:disabled .unity-base-slider__dragger,
.dennoko-root .unity-min-max-slider:disabled .unity-min-max-slider__dragger,
.dennoko-root .unity-min-max-slider:disabled .unity-min-max-slider__min-thumb,
.dennoko-root .unity-min-max-slider:disabled .unity-min-max-slider__max-thumb {
    background-color: var(--dennoko-text-disabled);
}
