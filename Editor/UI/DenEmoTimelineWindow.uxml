<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <!-- メインウィンドウが閉じていてタイムラインが開けない時の通知 -->
    <ui:VisualElement name="tlwin-notice" class="dennoko-card dennoko-empty-state dennoko-tlwin-notice">
        <ui:Label name="tlwin-notice-label" text="DenEmo Window is not open." class="dennoko-empty-state__message" />
        <ui:Button name="tlwin-open-main" text="Open DenEmo Window" class="dennoko-button-secondary" />
    </ui:VisualElement>

    <!-- タイムライン表示領域（C# が TimelineUITKView を構築） -->
    <ui:ScrollView name="tlwin-scroll" class="dennoko-scroll dennoko-tlwin-scroll">
        <ui:VisualElement name="tlwin-host" class="dennoko-tlwin-host" />
    </ui:ScrollView>
</ui:UXML>
