<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <!-- シェイプキーリストの外枠。他のセクションカードとデザインを統一 -->
    <ui:VisualElement name="shape-list-card" class="dennoko-card">
        <ui:VisualElement class="dennoko-card-header dennoko-toggle-header">
            <ui:Label name="shape-list-title" text="SHAPE KEYS" class="dennoko-section-title" />
            <ui:VisualElement class="dennoko-hrow">
                <ui:Button name="shape-list-bulk-menu" class="dennoko-mini-button dennoko-mini-button--auto" />
                <ui:Button name="shape-list-snap-create" class="dennoko-mini-button dennoko-mini-button--auto" />
                <ui:Button name="shape-list-snap-restore" class="dennoko-mini-button dennoko-mini-button--auto" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="shape-list-empty" class="dennoko-text-tertiary dennoko-wrap dennoko-list-message" style="display: none;" />
        <ui:Label name="shape-list-nomatch" class="dennoko-text-tertiary dennoko-wrap dennoko-list-message" style="display: none;" />
        <ui:ScrollView name="shape-list-scroll" class="dennoko-list-scroll" />
    </ui:VisualElement>
</ui:UXML>
